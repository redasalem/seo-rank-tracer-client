  "legal": {
    "privacy": {
      "title": "سياسة الخصوصية",
      "lastUpdated": "آخر تحديث:",
      "section1": {
        "title": "1. المعلومات التي نجمعها",
        "desc": "نقوم بجمع المعلومات التي تقدمها لنا مباشرة عند إنشاء حساب، أو الاشتراك في النشرة الإخبارية، أو استخدام خدماتنا. قد يشمل ذلك اسمك وعنوان بريدك الإلكتروني ومعلومات الدفع."
      },
      "section2": {
        "title": "2. كيف نستخدم معلوماتك",
        "desc": "نستخدم المعلومات التي نجمعها لتشغيل الخدمة وصيانتها وتوفير ميزاتها ووظائفها، بالإضافة إلى التواصل المباشر معك، مثل إرسال رسائل بريد إلكتروني تتعلق بحسابك أو تحديثات خدماتنا."
      },
      "section3": {
        "title": "3. أمن البيانات",
        "desc": "نحن نهتم بأمن معلوماتك ونستخدم ضمانات معقولة تجارياً للحفاظ على سلامة وأمن جميع المعلومات التي نجمعها والتي نشاركها مع مزودي الخدمة التابعين لنا."
      },
      "note": "هذا نموذج لسياسة الخصوصية. يرجى تحديثه بالسياسة القانونية الفعلية الخاصة بك."
    },
    "terms": {
      "title": "شروط الخدمة",
      "lastUpdated": "آخر تحديث:",
      "section1": {
        "title": "1. قبول الشروط",
        "desc": "عن طريق الوصول إلى هذه الخدمة واستخدامها، فإنك تقبل وتوافق على الالتزام بشروط وأحكام هذه الاتفاقية. بالإضافة إلى ذلك، عند استخدام هذه الخدمات المحددة، ستخضع لأي إرشادات أو قواعد منشورة تنطبق على هذه الخدمات."
      },
      "section2": {
        "title": "2. تقديم الخدمة",
        "desc": "نحتفظ بالحق في تعديل أو إيقاف الخدمة (أو أي جزء منها) مؤقتاً أو بشكل دائم مع أو بدون إشعار. أنت توافق على أننا لن نكون مسؤولين تجاهك أو تجاه أي طرف ثالث عن أي تعديل أو تعليق أو إيقاف للخدمة."
      },
      "section3": {
        "title": "3. حسابات المستخدمين",
        "desc": "لاستخدام ميزات معينة في الخدمة، يجب عليك التسجيل للحصول على حساب. أنت مسؤول عن الحفاظ على سرية حسابك وكلمة المرور وتقييد الوصول إلى جهاز الكمبيوتر أو الجهاز الخاص بك."
      },
      "note": "هذا نموذج لشروط الخدمة. يرجى تحديثه بالشروط القانونية الفعلية الخاصة بك."
    }
  },
